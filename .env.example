# FormFinance - Environment Variables Example
# Copy this file to .env at the root of the repository before running the service.

# Environment setup (development | staging | production)
FORMWISE_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Demo Authentication Mode (for offline/demo execution without Firebase)
# Set BOTH to true for demo authentication mode.
# Note: DEMO_AUTH_ENABLED=true is structurally rejected when FORMWISE_ENV=production.
DEMO_AUTH_ENABLED=true
NEXT_PUBLIC_DEMO_AUTH_ENABLED=true

# Firebase Credentials (Backend) - Required if DEMO_AUTH_ENABLED=false
# FIREBASE_PROJECT_ID=formfinance-dev
# FIREBASE_SERVICE_ACCOUNT_PATH=path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'

# Firebase Configuration (Frontend Web) - Required if NEXT_PUBLIC_DEMO_AUTH_ENABLED=false
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=formfinance.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=formfinance-dev

# AI Finance Agent Configuration
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=30.0

# Optional External AI API Keys (if using cloud AI providers)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
UPLOAD_SIGNING_SECRET=local-dev-upload-signing-secret-change-me
